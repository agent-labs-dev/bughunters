node_modules/
dist/
*.tsbuildinfo
coverage/
.DS_Store
*.log

# AutoQA local state. The committed files under .autoqa/ are whitelisted below;
# everything else in there is run-local scratch.
#
# A pattern containing a slash is anchored to this file's directory, so a bare
# `.autoqa/*` misses `examples/*/.autoqa/`. The `**/` prefix applies it at
# every depth.
**/.autoqa/*
!**/.autoqa/appmodel.json
!**/.autoqa/baselines.manifest.json
!**/.autoqa/intents.json
!**/.autoqa/README.md

# The fixture app is a test subject, not a project: its baselines are captured
# fresh by scripts/determinism-check.sh and are tied to one machine's rendering.
examples/*/.autoqa/

.env
.env.*
!.env.example
test-results/
playwright-report/
