node_modules/
dist/
*.tsbuildinfo
coverage/
.DS_Store
*.log

# Bughunters local data. Everything else in .bughunters/ (the config, the app
# guide, and the gate's manifests) is committed.
#
# A pattern containing a slash is anchored to this file's directory, so a bare
# `.bughunters/runs/` misses `examples/*/.bughunters/runs/`. The `**/` prefix
# applies it at every depth.
**/.bughunters/runs/

# The fixture app is a test subject, not a project: its baselines are captured
# fresh by scripts/determinism-check.sh and are tied to one machine's rendering.
examples/fixture-app/.bughunters/*
!examples/fixture-app/.bughunters/bughunters.yml

.env
.env.*
!.env.example
test-results/
playwright-report/

# Copied from packages/dashboard/src/ui by the bughunters bundle build.
packages/bughunters/src/ui/

# Generated redistribution notices; originals live at the repository root.
packages/bughunters/LICENSE
packages/bughunters/NOTICE
